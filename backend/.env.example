# Copy this file to ".env" (in the backend/ folder) and fill in your values.
# The server loads it automatically, so you never have to `export` again.

# Required: your fal.ai API key (https://fal.ai/dashboard/keys)
FAL_KEY=your-fal-key-here

# Optional: personalized couplet via OpenRouter. Without it, template verses are used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# The URL the browser uses to fetch finished images.
# Local testing: http://localhost:8000
# Event/hosted:  your public https URL, e.g. https://booth.example.com
PUBLIC_HOST=http://localhost:8000
