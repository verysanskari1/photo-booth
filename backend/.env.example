# Copy this file to ".env" (in the backend/ folder) and fill in your values.
# The server loads it automatically, so you never have to `export` again.

# Required: your fal.ai API key (https://fal.ai/dashboard/keys)
FAL_KEY=your-fal-key-here

# Optional: personalized couplet via OpenRouter. Without it, template verses are used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# The URL the browser uses to fetch finished images.
# Local testing: http://localhost:8000
# Event/hosted:  your public https URL, e.g. https://booth.example.com
PUBLIC_HOST=http://localhost:8000

# --- Delivery to an offsite printer via a synced Drive folder ------------
# Point this at a folder inside your Google Drive for Desktop (or Dropbox)
# folder. Each finished strip is copied here and auto-syncs to the cloud, where
# the remote print station picks it up. Empty = delivery off.
# Example: /Users/you/Library/CloudStorage/GoogleDrive-you@x.com/My Drive/Photobooth
DRIVE_FOLDER=

# --- Printing on a LOCALLY attached printer (DS620A via CUPS on macOS) ----
# Set PRINTER_NAME to the queue from `lpstat -p` (empty = system default).
# Find media/PageSize choices with: lpoptions -p <PRINTER_NAME> -l
PRINTER_NAME=
PRINT_MEDIA=
PRINT_OPTIONS=
PRINT_COPIES=1
# Set to 0 to disable real printing (UI falls back to the browser dialog).
PRINT_ENABLED=1
